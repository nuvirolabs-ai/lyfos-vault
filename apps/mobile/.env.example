# Lyfos mobile — env vars consumed by app.config.js at build time.
# Copy this file to apps/mobile/.env.local for local Expo dev, or
# set in EAS Build env (per channel: development / preview / production).
#
# Anything prefixed with EXPO_PUBLIC_ is inlined into the JS bundle —
# treat as PUBLIC. Don't put service-role keys here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_URL=https://app.lyfos.in
