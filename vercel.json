{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --workspace=@os-one/web --include-workspace-root --no-audit --no-fund",
  "buildCommand": "npm run build --workspace=@os-one/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/refund-policy", "destination": "/refund-cancellation/index.html" },
    { "source": "/refund-cancellation", "destination": "/refund-cancellation/index.html" },
    { "source": "/delivery", "destination": "/shipping-delivery/index.html" },
    { "source": "/shipping-delivery", "destination": "/shipping-delivery/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
