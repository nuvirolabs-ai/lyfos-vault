{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --workspace=@os-one/web --include-workspace-root --no-audit --no-fund",
  "buildCommand": "npm run build --workspace=@os-one/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/create-order", "destination": "/api/create-order" },
    { "source": "/api/verify-payment", "destination": "/api/verify-payment" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/refund-policy", "destination": "/refund-cancellation/index.html" },
    { "source": "/refund-cancellation", "destination": "/refund-cancellation/index.html" },
    { "source": "/delivery", "destination": "/shipping-delivery/index.html" },
    { "source": "/shipping-delivery", "destination": "/shipping-delivery/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://rifooyrwepkrhprakdec.supabase.co wss://rifooyrwepkrhprakdec.supabase.co; frame-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
