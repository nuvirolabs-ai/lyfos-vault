# OS noise
.DS_Store

# Dependencies (npm workspaces install at root and inside each app/package)
node_modules/
*/node_modules/
**/node_modules/

# Local env. NEVER commit these — they hold deploy secrets.
.env
.env.local
.env.*.local
*.env

# Vite cache
.vite/
**/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor noise
.idea/
.vscode/*
!.vscode/settings.json

# Generated web/app output
apps/web/dist/
apps/mobile/.expo/

# Codex/local tooling state
.claude/
.playwright-cli/
.superpowers/
.static-server.cjs
supabase/.temp/

# Build artifacts (regenerated by npm run package:web)
build/
**/build/
.vercel
