# OS noise
.DS_Store

# Dependencies (npm workspaces install at root and inside each app/package)
node_modules/
*/node_modules/
**/node_modules/

# Local env. NEVER commit these — they hold deploy secrets.
.env
.env.local
.env.*.local
*.env

# Vite cache
.vite/
**/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor noise
.idea/
.vscode/*
!.vscode/settings.json

# Note: apps/web/dist/ is intentionally committed — the host serves
# static files directly from this branch. Until Phase 6 (real CI/CD),
# we ship the bundle with the source.

# Build artifacts (regenerated by npm run package:web)
build/
**/build/
.vercel
